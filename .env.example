# Copy to .env and fill in. Never commit real values.
#
# ── App (public) ────────────────────────────────────────────────────────────
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone, so only
# the Supabase URL and anon/publishable key belong here. RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (Project settings → API keys → App specific keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Shown on the paywall; the stores require both links.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# ── Supabase local stack (read by supabase/config.toml) ────────────────────
# Apple: comma-separated iOS bundle id and Services ID, plus the generated client secret JWT.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Google: OAuth web client id and secret from Google Cloud console.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Edge Function secrets (server only) ────────────────────────────────────
# Never prefix these with EXPO_PUBLIC_. Hosted: `npx supabase secrets set ANTHROPIC_API_KEY=...`.
# Local: put them in supabase/functions/.env (git-ignored) and run `npm run fn:serve`.
ANTHROPIC_API_KEY=
# RevenueCat: secret API key (v1) for reading subscribers, and the value you set as the
# webhook's Authorization header in the RevenueCat dashboard.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
