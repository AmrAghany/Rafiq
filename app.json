{
  "expo": {
    "name": "Rafiq",
    "slug": "rafiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rafiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rafiq.app",
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rafiq.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5FBF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#12161D"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1F5FBF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rafiq uses your photos to read your InBody scan sheet and estimate your meals.",
          "cameraPermission": "Rafiq uses the camera to photograph your InBody scan sheet and your meals.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["ios", "android"]
  }
}
